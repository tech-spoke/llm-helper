# =============================================================
# .gitignore — C分類（どちらのリポジトリにも追跡しない）
# 参照: docs/updates/v1.14_ja.md「ファイル分類 > C」
# =============================================================

# Python 環境
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv/
.env

# OS
.DS_Store
Thumbs.db
*:Zone.Identifier

# IDE
.vscode/
.idea/
*.swp
*.swo

# ログ
logs/
*.log

# データベース
vectors.db
*.db

# モデル（大容量・ダウンロードで再現可能）
models/

# 実行時生成物: .code-intel/**
**/.code-intel/*
!templates/code-intel/
!templates/code-intel/**
!templates/skills/
!templates/skills/**
config.json
!templates/code-intel/config.json

# LLM コマンド生成物（init-project.sh が生成）
.claude/commands/

# LLM ローカル設定（環境依存）
.claude/settings.local.json

# Codex ローカル
.codex/

# Playwright
.playwright-mcp/

# プロジェクト固有の生成物
*.jsonl
.mcp.json

# ローカル専用ドキュメント（追跡防止）
docs/old/
docs/qiita/
